{
  "name": "lagune-immo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --configLoader native\" \"node --watch server/index.js\"",
    "dev:ui": "vite --host 127.0.0.1 --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort --configLoader native",
    "test:ui": "playwright test",
    "start": "node server/index.js",
    "db:migrate": "node server/migrate.js",
    "db:seed": "node server/seed.js",
    "test": "node --test tests/*.test.js",
    "worker": "node server/worker.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.17.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}
