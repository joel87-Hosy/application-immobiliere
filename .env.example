NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://lagune_app:CHANGE_ME@127.0.0.1:5432/lagune
# Separate migration role with schema ownership; never use it for the API.
MIGRATION_DATABASE_URL=postgresql://lagune_owner:CHANGE_ME@127.0.0.1:5432/lagune
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
STORAGE_DIR=./storage
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=quittances@example.com
# Only used by the initial seed script; supply your own password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
